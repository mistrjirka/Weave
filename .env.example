# Optional deployment overrides. This file is documentation, NOT auto-loaded.
# Normal installs persist settings with scripts/configure.sh in .weave-config.json.
# To use these instead, export them before running scripts/start.sh.
WEAVE_PROJECTS_DIR=~/shared/weave-projects
WEAVE_HOST=0.0.0.0
WEAVE_PORT=8173
# WEAVE_DATA=/absolute/path/to/internal-app-data
# WEAVE_TRAINING_ENABLED=1
# WEAVE_TRAINING_PYTHON=/absolute/path/to/training-venv/bin/python
# WEAVE_CONFIG_FILE=/absolute/path/to/settings/weave.json
# Explicit public MCP origins when using Docker or a reverse proxy:
# WEAVE_MCP_PUBLIC_ORIGINS=https://weave.example.com,http://192.168.1.10:8173
