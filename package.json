{
  "name": "neural-graph-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": ".venv/bin/python -m pytest tests -q",
    "format": "prettier --write frontend/src tsconfig.json vite.config.ts",
    "format:check": "prettier --check frontend/src tsconfig.json vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test:routing": "node --test tests/routing.test.ts tests/labels.test.ts tests/layout.test.ts tests/workspaceLocation.test.ts",
    "test:clipboard": "node --test tests/graphClipboard.test.ts",
    "test:variables": "node --test tests/graphVariables.test.ts",
    "test:controls": "node --test tests/weightGroups.test.ts tests/transformerControls.test.ts"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^1.1.5",
    "@lezer/highlight": "^1.2.5",
    "@xyflow/react": "^12.9.0",
    "codemirror": "^6.0.2",
    "elkjs": "^0.12.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/dagre": "^0.7.53",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
